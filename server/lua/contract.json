  "state": {
    "v": 5,
    "tick_id": "canonical decimal string [0,9223372036854775807]",
    "seq": "canonical decimal string [0,18446744073709551615]",
    "match_id": "canonical decimal string [0,18446744073709551615]",
    "world_id": "canonical decimal string; scoped by session, increases for each new world",
    "raid": {
      "player_state": "Alive|Dead|Extracted|Abandoned",
      "random": "canonical decimal uint32 string [1,4294967295]",
      "dropped": "unique array of dead monster identities, at most 64",
      "extract_id": "integer exit configuration id or zero",
      "extract_ticks": "integer accumulated ticks [0,36000]",
      "extract_reason": "locked|outside|hurt|dead|counting|complete",
      "damage_tick": "canonical decimal tick string <= tick_id"
    },
    "player_id": "canonical decimal string [0,18446744073709551615]",
    "event_id": "canonical decimal string [0,18446744073709551615]",
    "phase": "Unauthenticated|Lobby|Preparing|Playing|Settling|Finished|Aborted; Dead/Cleared only in combat regression fixture",
    "paused": "boolean",
    "content_key": "canonical JSON encoding of complete immutable content; exact import match",
    "entities": {
      "max": 64,
      "key": "positive canonical uint64 string, exactly matches instance id",
      "common": {
        "id": "positive canonical uint64 string <= last_entity_id",
        "kind": "player|monster",
        "cfg_id": "canonical decimal string [1,2147483647], resolves by kind",
        "pose": {
          "x": "integer millimeters, inside map by referenced body",
          "y": "integer millimeters, inside map by referenced body",
          "facing": "integer -1|1"
        },
        "pending_remove": "boolean; only monsters may be marked",
        "motion": {
          "vx": "integer within referenced speed",
          "vy": "integer [-1000, own jump_speed or 0]",
          "grounded": "boolean, agrees with geometry"
        },
        "health": {
          "hp": "integer [0,max_hp]",
          "max_hp": "integer equal to referenced hp",
          "alive": "boolean, equals hp > 0"
        }
      },
      "player": {
        "player_id": "same as world.player_id",
        "controls": {
          "move_x": "integer [-1,1]",
          "aim_x": "integer [-1000,1000]",
          "aim_y": "integer [-1000,1000]",
          "jump": "boolean",
          "fire": "boolean",
          "fire_once": "boolean",
          "reload": "boolean"
        },
        "reserve": "integer [0,weapon cfg reserve]",
        "weapon": {
          "cfg_id": "map.spawn.weapon_cfg_id",
          "ammo": "integer [0,cfg.magazine]",
          "shot_ticks": "integer [0,cfg.fire_ticks]",
          "reload_ticks": "integer [0,cfg.reload_ticks]"
        }
      },
      "monster": {
        "spawn_id": "positive canonical cfg-range string; resolves to map.enemies spawn_id and matching cfg_id",
        "ai": {
          "state": "spawn|patrol|chase|attack|windup|recover|dead; spawn requires full health at rest at configured origin",
          "attack_ticks": "integer [0,cfg.attack_ticks]"
        }
      },
      "extra_fields": false
    },
    "last_start": {
      "req_id": "string [0,128] bytes",
      "after_match_id": "canonical uint64 decimal string",
      "match_id": "canonical uint64 decimal string"
    },
    "extra_fields": false,
    "player_entity_id": "canonical uint64 decimal string; 0 before first match; references sole player",
    "last_entity_id": "canonical uint64 decimal string; per-match high water, never reused",
    "entity_ids": {
      "max": 64,
      "item": "positive canonical uint64 string",
      "unique": true,
      "order": "stable spawn order; removal preserves survivors"
    },
    "invariants": [
      "entity_ids and entities form a bijection; no entity object aliases",
      "sole player resolves from player_entity_id and matches initial player and weapon cfg",
      "death zeros motion and own cooldowns; monster ai becomes dead",
      "paused or terminal player controls are neutral; terminal motion is zero",
      "Playing requires live player; Boss death only unlocks exit; Settling/Finished require a final player outcome; Dead/Cleared remain regression fixture phases",
      "inactive phases have empty entities and indices and zero allocator and player entity id",
      "match_id is allocated persistently and exceeds last_start.after_match_id; existing request and sequence invariants retained"
    ],
    "items": {
      "max": 64,
      "key": "positive canonical uint64 string matching instance id",
      "fields": {
        "id": "positive uint64 string <= last_item_id",
        "cfg_id": "canonical decimal string [1,2147483647]; Ground/Bag resolve content.items",
        "count": "integer [1,2147483647]; Ground/Bag bounded by MaxStack",
        "place": "None|Ground|Bag; None only for native object regression fixtures",
        "owner_player_id": "canonical decimal player id for Bag, otherwise zero",
        "x": "integer map coordinate; Bag uses zero",
        "y": "integer map coordinate; Bag uses zero"
      }
    },
    "last_item_id": "canonical uint64 string; per-match high water, never reused",
    "owner": "C++ World; Lua retains immutable identity and generation-checked handles only",
    "world_id": "server assigned runtime identity, nonzero for an active match",
    "raid": "native player_state/random/dropped/extract_id/extract_ticks/extract_reason/damage_tick"
  },
