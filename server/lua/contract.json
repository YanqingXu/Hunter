{
  "version": 5,
  "host_api": {
    "net.emit": {
      "args": [
        "string kind",
        "string payload_json"
      ],
      "returns": "boolean",
      "usage": "cold JSON adapter only; deployed high-frequency paths use native input, net.event and net.snapshot"
    },
    "cfg.get": {
      "args": [],
      "returns": "string ctx_json"
    },
    "diagnostics.log": {
      "args": [
        "string message"
      ],
      "returns": "boolean"
    },
    "entries": {
      "init": [
        "string ctx_json"
      ],
      "on_event": [
        "integer event_id",
        "string payload_json"
      ],
      "tick": [
        "integer tick_id",
        "number dt_seconds"
      ],
      "export_state": [],
      "import_state": [
        "string snapshot_json"
      ],
      "validate_state": [],
      "shutdown": [
        "string reason"
      ]
    },
    "entry_returns": "boolean true except export_state returns string",
    "ctx": {
      "v": 5,
      "snapshot_every": "integer [1,3600]",
      "content": "validated exported content object"
    },
    "net.event": {
      "args": [
        "string kind",
        "string actor_id",
        "string target_id",
        "integer x",
        "integer y",
        "integer amount"
      ],
      "returns": "boolean"
    },
    "net.snapshot": {
      "args": [],
      "returns": "boolean"
    },
